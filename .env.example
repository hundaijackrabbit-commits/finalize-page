# Finalize.page Phase 1B
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: enables real auth + persistent organization-scoped Rooms.
# Leave unset to run the safe local demo fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Private S3 artifact intake. Required only for production file uploads.
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
FINALIZE_UPLOAD_BUCKET=

# Phase 1C trust-processing workers
FINALIZE_WORKER_SECRET=replace-with-a-long-random-secret
# production default: guardduty; trusted_dev is refused in NODE_ENV=production
FINALIZE_MALWARE_MODE=guardduty
FINALIZE_ZIP_MAX_ENTRIES=20000
FINALIZE_ZIP_MAX_EXPANDED_BYTES=2147483648
FINALIZE_ZIP_MAX_RATIO=250
FINALIZE_PARSE_MAX_BYTES=52428800
FINALIZE_PRIVACY_TEXT_MAX_BYTES=26214400
FINALIZE_BASE_URL=http://localhost:3000
FINALIZE_WORKER_INTERVAL_MS=2500
FINALIZE_WORKER_BATCH=8

# Phase 2 agency completion
# 32-byte key, base64 or 64-char hex. Required for encrypted guest credential/access submissions.
FINALIZE_VAULT_KEY=
# Generic HMAC payment completion webhook. Replace with a provider adapter (Stripe, etc.) in production.
FINALIZE_PAYMENT_WEBHOOK_SECRET=
# Optional email delivery adapter used by the reminder worker endpoint.
FINALIZE_EMAIL_WEBHOOK_URL=
FINALIZE_EMAIL_WEBHOOK_SECRET=
